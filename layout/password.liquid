<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <style>
    :root { --bg: {{ settings.color_bg }}; --ink: {{ settings.color_ink }}; --accent: {{ settings.color_accent }}; --sky: {{ settings.color_sky }}; --font-head: 'Fraunces', serif; --font-body: 'Inter', system-ui, sans-serif; }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <main class="wrap">{{ content_for_layout }}</main>
</body>
</html>
