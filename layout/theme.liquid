<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}

  <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {%- if page_description != blank -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  {%- if page_description != blank -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- assign og_image = product.featured_image | default: collection.image | default: page_image -%}
  {%- if og_image != blank -%}
    <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    :root {
      --bg: {{ settings.color_bg }};
      --ink: {{ settings.color_ink }};
      --accent: {{ settings.color_accent }};
      --sky: {{ settings.color_sky }};
      --font-head: 'Fraunces', 'Times New Roman', serif;
      --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    }
  </style>
  <script>document.documentElement.classList.add('js');</script>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>

<body class="template-{{ template.name | handleize }}">
  <a class="skip-link" href="#main">Saltar al contenido</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
</body>
</html>
