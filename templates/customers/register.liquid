<div class="wrap">
  <div class="form-card">
    <h1 class="display display--lg">Crear cuenta</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="r-first">Nombre</label><input class="input" id="r-first" type="text" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="r-last">Apellidos</label><input class="input" id="r-last" type="text" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="field"><label for="r-email">Correo electrónico</label><input class="input" id="r-email" type="email" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="r-pw">Contraseña</label><input class="input" id="r-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <button class="btn btn--block" type="submit">Crear cuenta</button>
    {%- endform -%}
    <p class="alt">¿Ya tienes cuenta? <a href="{{ routes.account_login_url }}">Entrar</a></p>
  </div>
</div>
