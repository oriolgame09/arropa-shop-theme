<div class="wrap">
  <div class="form-card">
    <h1 class="display display--lg">Nueva contraseña</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="rp1">Contraseña</label><input class="input" id="rp1" type="password" name="customer[password]" required></div>
      <div class="field"><label for="rp2">Repetir contraseña</label><input class="input" id="rp2" type="password" name="customer[password_confirmation]" required></div>
      <button class="btn btn--block" type="submit">Guardar</button>
    {%- endform -%}
  </div>
</div>
