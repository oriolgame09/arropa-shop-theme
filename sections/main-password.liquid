<div class="form-card" style="text-align:center;">
  <p class="logo" style="margin-bottom: 40px;">{{ shop.name }}</p>
  <h1 class="display display--lg" style="margin-bottom: 20px;">Muy pronto</h1>
  <p class="lead" style="margin: 0 auto 32px;">Estamos preparando algo cálido. Vuelve en unos días.</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="field">
      <label class="visually-hidden" for="pw">Contraseña</label>
      <input class="input" id="pw" type="password" name="password" placeholder="Contraseña">
    </div>
    <button class="btn btn--block" type="submit">Entrar</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Contraseña" }
{% endschema %}
