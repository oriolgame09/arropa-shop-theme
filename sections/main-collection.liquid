{%- paginate collection.products by section.settings.per_page -%}
  <div class="wrap">
    <div class="page-head reveal">
      <p class="eyebrow">Colección</p>
      <h1 class="display display--lg">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="lead rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty">
        <p class="display display--md">Aún no hay productos aquí.</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">Ver todo</a>
      </div>
    {%- endif -%}
  </div>
  <div style="height: clamp(56px, 8vw, 112px)"></div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Productos por página", "min": 8, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
