<section class="band">
  <div class="wrap section" style="padding-bottom: 0;">
    <div class="section__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="display display--xl" style="font-size: clamp(2.4rem, 6vw, 5rem);">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead" style="margin-top: 20px;">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>
</section>

<section class="section" style="padding-top: clamp(40px, 5vw, 72px);">
  <div class="wrap">
    <div class="grid grid--3">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="card">
            <div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'card__img placeholder' }}</div>
            <div class="card__info"><h3 class="card__title">Producto de ejemplo</h3><div class="price"><span class="price__current">0,00 €</span></div></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.collection != blank and section.settings.button_label != blank -%}
      <div style="text-align:center; margin-top: 56px;">
        <a class="btn btn--ghost" href="{{ section.settings.collection.url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Para ti" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Nuestra colección de <em>invierno</em>" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Piezas pensadas para pasar el invierno en casa con calor y sin encender la calefacción." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Número de productos", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver toda la colección" }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
