<section class="band">
  <div class="wrap section" style="padding-bottom: 0;">
    <div class="section__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="display display--xl" style="font-size: clamp(2.4rem, 6vw, 5rem);">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead" style="margin-top: 20px;">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>
</section>

<section class="section" style="padding-top: clamp(40px, 5vw, 72px);">
  <div class="wrap">
    <div class="grid grid--3">
      {%- assign source = section.settings.collection | default: collections['all'] -%}
      {%- for product in source.products limit: section.settings.limit -%}
        {% render 'product-card', product: product, buy_now: section.settings.buy_now %}
      {%- else -%}
        <p>Aún no hay productos. Añádelos en Shopify → Productos.</p>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div style="text-align:center; margin-top: 56px;">
        <a class="btn btn--ghost" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Para ti" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Nuestra colección de <em>invierno</em>" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Piezas pensadas para pasar el invierno en casa con calor y sin encender la calefacción." },
    { "type": "collection", "id": "collection", "label": "Colección (si la dejas vacía se muestran todos los productos)" },
    { "type": "checkbox", "id": "buy_now", "label": "Mostrar botón «Comprar ahora» (va directo al pago)", "default": true },
    { "type": "range", "id": "limit", "label": "Número de productos", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver toda la colección" }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
