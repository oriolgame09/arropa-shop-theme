{%- if section.settings.text != blank -%}
  <div class="announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis con seguimiento · 14 días para devolverlo" },
    { "type": "url", "id": "link", "label": "Enlace (opcional)" }
  ]
}
{% endschema %}
