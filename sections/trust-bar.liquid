<div class="trust">
  <div class="wrap trust__grid">
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }}>
        <p class="trust__title">{{ block.settings.title }}</p>
        <p class="trust__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Barra de confianza",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Punto",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Envío gratis" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Con seguimiento, en 5-10 días laborables" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de confianza",
      "blocks": [
        { "type": "item", "settings": { "title": "Envío gratis", "text": "Con seguimiento, en 5-10 días laborables" } },
        { "type": "item", "settings": { "title": "14 días para devolverlo", "text": "Si no te convence, nos lo devuelves" } },
        { "type": "item", "settings": { "title": "Pago seguro", "text": "Tarjeta, Apple Pay o Google Pay" } }
      ]
    }
  ]
}
{% endschema %}
