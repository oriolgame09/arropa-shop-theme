<div class="wrap">
  <div class="page-head reveal">
    <p class="eyebrow">Explora</p>
    <h1 class="display display--lg">Colecciones</h1>
  </div>
  <div class="collections-grid">
    {%- for collection in collections -%}
      <a class="collection-tile reveal" href="{{ collection.url }}">
        <div class="collection-tile__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 30vw, 50vw', alt: collection.title }}
          {%- elsif collection.products.first.featured_image -%}
            {{ collection.products.first.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <h2>{{ collection.title }}</h2>
      </a>
    {%- endfor -%}
  </div>
  <div style="height: clamp(56px, 8vw, 112px)"></div>
</div>

{% schema %}
{ "name": "Lista de colecciones" }
{% endschema %}
