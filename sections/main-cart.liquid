<div class="wrap">
  <div class="page-head">
    <h1 class="display display--lg">Tu cesta</h1>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="empty">
      <p class="display display--md">Tu cesta está vacía.</p>
      <a class="btn btn--accent" href="{{ routes.all_products_collection_url }}">Seguir comprando</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      {%- for item in cart.items -%}
        <div class="cart-line">
          <a class="cart-line__img" href="{{ item.url }}">
            {%- if item.image -%}
              {%- assign line_alt = item.image.alt | default: item.product.title | escape -%}
              {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: line_alt }}
            {%- endif -%}
          </a>
          <div>
            <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}
              <p class="cart-line__meta">{{ item.variant.title }}</p>
            {%- endunless -%}
            <p class="cart-line__meta">{{ item.original_price | money }}</p>
            <a class="cart-line__remove" href="{{ item.url_to_remove }}">Quitar</a>
          </div>
          <div class="cart-line__side">
            <div class="qty" data-qty>
              <button type="button" data-step="down" aria-label="Menos">−</button>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Cantidad de {{ item.product.title | escape }}">
              <button type="button" data-step="up" aria-label="Más">+</button>
            </div>
            <strong>{{ item.final_line_price | money }}</strong>
          </div>
        </div>
      {%- endfor -%}

      <div class="cart-summary">
        <div class="cart-summary__row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
        <small>Impuestos incluidos. Envío calculado al pagar.</small>
        <button class="btn btn--accent btn--block" type="submit" name="checkout">Finalizar compra</button>
        <button class="btn btn--ghost btn--block" type="submit" name="update">Actualizar cesta</button>
      </div>
    </form>
  {%- endif -%}
  <div style="height: clamp(56px, 8vw, 112px)"></div>
</div>

{% schema %}
{ "name": "Cesta" }
{% endschema %}
