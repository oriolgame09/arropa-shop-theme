{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="wrap product" data-product>
  <div class="product__gallery">
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        <figure>
          {%- liquid
            assign eager = 'lazy'
            if forloop.first
              assign eager = 'eager'
            endif
          -%}
          {{ media | image_url: width: 1400 | image_tag: loading: eager, widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 55vw, 100vw', alt: media.alt | default: product.title }}
        </figure>
      {%- endif -%}
    {%- else -%}
      <figure>{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</figure>
    {%- endfor -%}
  </div>

  <div class="product__info">
    {%- if section.settings.show_vendor and product.vendor != blank -%}
      <p class="eyebrow">{{ product.vendor }}</p>
    {%- endif -%}
    <h1 class="product__title">{{ product.title }}</h1>
    <div class="product__price">{% render 'price', product: product %}</div>

    {%- form 'product', product, id: 'product-form', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="option" data-option>
            <legend>{{ option.name }}</legend>
            <div class="option__values">
              {%- for value in option.values -%}
                {%- assign uid = 'opt-' | append: option.position | append: '-' | append: forloop.index -%}
                <input type="radio" id="{{ uid }}" name="option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                <label for="{{ uid }}">{{ value }}</label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      {%- if form.errors -%}
        <p class="form-error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="buy">
        <div class="qty" data-qty>
          <button type="button" data-step="down" aria-label="Menos">−</button>
          <input type="number" name="quantity" value="1" min="1" aria-label="Cantidad">
          <button type="button" data-step="up" aria-label="Más">+</button>
        </div>
        <button class="btn btn--accent" type="submit" name="add" data-add{% unless current_variant.available %} disabled{% endunless %}>
          <span>{% if current_variant.available %}Añadir a la cesta{% else %}Agotado{% endif %}</span>
        </button>
      </div>

      {%- if section.settings.show_dynamic_checkout -%}
        {{ form | payment_button }}
      {%- endif -%}
    {%- endform -%}

    <script type="application/json" data-variants>
      [{% for v in product.variants %}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available }},"price":{{ v.price | money | json }},"compare":{{ v.compare_at_price | money | json }},"onsale":{% if v.compare_at_price > v.price %}true{% else %}false{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
    </script>

    {%- if product.description != blank -%}
      <div class="product__desc rte">{{ product.description }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'perks' -%}
          <ul class="perks" {{ block.shopify_attributes }}>
            {%- for i in (1..3) -%}
              {%- assign key = 'perk_' | append: i -%}
              {%- if block.settings[key] != blank -%}<li>{{ block.settings[key] }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- when 'tab' -%}
          <details class="acc" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading }} {% render 'icon', name: 'plus' %}</summary>
            <div class="acc__body">{{ block.settings.content }}</div>
          </details>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botones de pago rápido (Apple Pay, Google Pay…)", "default": true }
  ],
  "blocks": [
    {
      "type": "perks",
      "name": "Ventajas",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Ventaja 1", "default": "Envío gratis con seguimiento" },
        { "type": "text", "id": "perk_2", "label": "Ventaja 2", "default": "14 días para devolverlo" },
        { "type": "text", "id": "perk_3", "label": "Ventaja 3", "default": "Pago seguro" }
      ]
    },
    {
      "type": "tab",
      "name": "Pestaña desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Envíos" },
        { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Envío gratuito con seguimiento en 5-10 días laborables.</p>" }
      ]
    }
  ]
}
{% endschema %}
