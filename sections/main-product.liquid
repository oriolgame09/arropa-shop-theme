{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="wrap product" data-product data-low-stock="{{ section.settings.low_stock }}" data-min-days="{{ section.settings.min_days }}" data-max-days="{{ section.settings.max_days }}">
  <div class="product__gallery">
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        <figure>
          {%- liquid
            assign eager = 'lazy'
            if forloop.first
              assign eager = 'eager'
            endif
          -%}
          {%- assign media_alt = media.alt | default: product.title | escape -%}
          {{ media | image_url: width: 1400 | image_tag: loading: eager, widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 55vw, 100vw', alt: media_alt }}
        </figure>
      {%- endif -%}
    {%- else -%}
      <figure>{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</figure>
    {%- endfor -%}
  </div>

  <div class="product__info">
    {%- if section.settings.show_vendor and product.vendor != blank -%}
      <p class="eyebrow">{{ product.vendor }}</p>
    {%- endif -%}
    <h1 class="product__title">{{ product.title }}</h1>
    <div class="product__price">{% render 'price', product: product %}</div>

    {%- if section.settings.low_stock > 0 -%}
      <p class="stock" data-stock hidden><i></i><span></span></p>
    {%- endif -%}

    {%- form 'product', product, id: 'product-form', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="option" data-option>
            <legend>{{ option.name }}</legend>
            <div class="option__values">
              {%- for value in option.values -%}
                {%- assign uid = 'opt-' | append: option.position | append: '-' | append: forloop.index -%}
                <input type="radio" id="{{ uid }}" name="option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                <label for="{{ uid }}">{{ value }}</label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      {%- assign size_guide = section.blocks | where: 'type', 'size_guide' | first -%}
      {%- if size_guide != blank -%}
        {%- if size_guide.settings.fit_note != blank -%}<p class="fit-note" {{ size_guide.shopify_attributes }}>{{ size_guide.settings.fit_note }}</p>{%- endif -%}
        {%- if size_guide.settings.table != blank -%}
          <button class="size-guide-btn" type="button" data-guide-open="size-guide">{{ size_guide.settings.button_label }}</button>
        {%- endif -%}
      {%- endif -%}

      {%- if form.errors -%}
        <p class="form-error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="buy">
        <div class="qty" data-qty>
          <button type="button" data-step="down" aria-label="Menos">−</button>
          <input type="number" name="quantity" value="1" min="1" aria-label="Cantidad">
          <button type="button" data-step="up" aria-label="Más">+</button>
        </div>
        <button class="btn btn--accent" type="submit" name="add" data-add{% unless current_variant.available %} disabled{% endunless %}>
          <span>{% if current_variant.available %}Añadir a la cesta{% else %}Agotado{% endif %}</span>
        </button>
      </div>

      {%- if section.settings.max_days > 0 -%}
        <p class="delivery" data-delivery>
          {% render 'icon', name: 'bag' %}
          <span>Entrega estimada: <strong data-delivery-range>{{ section.settings.min_days }}-{{ section.settings.max_days }} días laborables</strong> · envío gratis con seguimiento</span>
        </p>
      {%- endif -%}

      {%- if section.settings.show_dynamic_checkout -%}
        {{ form | payment_button }}
      {%- endif -%}
    {%- endform -%}

    <script type="application/json" data-variants>
      [{% for v in product.variants %}{"id":{{ v.id }},"options":{{ v.options | json }},"stock":{% if v.inventory_management == 'shopify' and v.inventory_quantity > 0 %}{{ v.inventory_quantity }}{% else %}0{% endif %},"available":{{ v.available }},"price":{{ v.price | money | json }},"compare":{{ v.compare_at_price | money | json }},"onsale":{% if v.compare_at_price > v.price %}true{% else %}false{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
    </script>

    {%- if product.description != blank -%}
      <div class="product__desc rte">{{ product.description }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'perks' -%}
          <ul class="perks" {{ block.shopify_attributes }}>
            {%- for i in (1..3) -%}
              {%- assign key = 'perk_' | append: i -%}
              {%- if block.settings[key] != blank -%}<li>{{ block.settings[key] }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- when 'size_guide' -%}
          {%- comment -%} Se muestra junto a las tallas (arriba). {%- endcomment -%}
        {%- when 'tab' -%}
          <details class="acc" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading }} {% render 'icon', name: 'plus' %}</summary>
            <div class="acc__body">{{ block.settings.content }}</div>
          </details>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

<div class="buybar" data-buybar aria-hidden="true">
  <div class="buybar__info">
    <span class="buybar__title">{{ product.title }}</span>
    <span class="price"><span class="price__current" data-price-mirror>{{ current_variant.price | money }}</span></span>
  </div>
  <button class="btn btn--accent" type="submit" form="product-form" name="add" data-add tabindex="-1"{% unless current_variant.available %} disabled{% endunless %}>
    <span>{% if current_variant.available %}Añadir{% else %}Agotado{% endif %}</span>
  </button>
</div>

{%- if size_guide != blank and size_guide.settings.table != blank -%}
  <dialog class="guide" id="size-guide" aria-labelledby="size-guide-title">
    <div class="guide__inner">
      <div class="guide__head">
        <h2 id="size-guide-title">{{ size_guide.settings.title }}</h2>
        <button class="icon-btn" type="button" data-guide-close aria-label="Cerrar">{% render 'icon', name: 'close' %}</button>
      </div>
      {{ size_guide.settings.table }}
    </div>
  </dialog>
{%- endif -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": false },
    { "type": "range", "id": "low_stock", "label": "Avisar cuando queden pocas unidades (solo con inventario real; 0 = no avisar)", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "min_days", "label": "Entrega: días laborables mínimos", "min": 1, "max": 30, "step": 1, "default": 5 },
    { "type": "range", "id": "max_days", "label": "Entrega: días laborables máximos (0 = ocultar)", "min": 0, "max": 40, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botones de pago rápido (Apple Pay, Google Pay…)", "default": true }
  ],
  "blocks": [
    {
      "type": "perks",
      "name": "Ventajas",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Ventaja 1", "default": "Envío gratis con seguimiento" },
        { "type": "text", "id": "perk_2", "label": "Ventaja 2", "default": "14 días para devolverlo" },
        { "type": "text", "id": "perk_3", "label": "Ventaja 3", "default": "Pago seguro" }
      ]
    },
    {
      "type": "size_guide",
      "name": "Guía de tallas",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Texto del enlace", "default": "Guía de tallas" },
        { "type": "text", "id": "title", "label": "Título del panel", "default": "Guía de tallas" },
        { "type": "text", "id": "fit_note", "label": "Línea de ajuste (ej.: Ajuste regular · Mide 1,75 y lleva M)" },
        { "type": "html", "id": "table", "label": "Tabla de medidas en HTML (si está vacía, no se muestra el enlace)", "default": "<table><thead><tr><th>Talla</th><th>Pecho (cm)</th><th>Cintura (cm)</th><th>Cadera (cm)</th></tr></thead><tbody><tr><td>S</td><td>—</td><td>—</td><td>—</td></tr><tr><td>M</td><td>—</td><td>—</td><td>—</td></tr><tr><td>L</td><td>—</td><td>—</td><td>—</td></tr></tbody></table><p>Sustituye los guiones por las medidas reales confirmadas con tu proveedor.</p>" }
      ]
    },
    {
      "type": "tab",
      "name": "Pestaña desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Envíos" },
        { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Envío gratuito con seguimiento en 5-10 días laborables.</p>" }
      ]
    }
  ]
}
{% endschema %}
