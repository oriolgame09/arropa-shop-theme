      },
      {
        "type": "color",
        "id": "color_glow",
        "label": "Luz fría (brillos y bordes)",
        "default": "#7FE3FF"
      }
    ]
  },
  {
    "name": "Logo y favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
