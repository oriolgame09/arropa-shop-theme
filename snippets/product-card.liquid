{%- comment -%} Uso: {% render 'product-card', product: product, buy_now: true %} {%- endcomment -%}
<article class="card reveal">
  <a class="card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image -%}
      {%- assign card_alt = product.featured_image.alt | default: product.title | escape -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: card_alt, class: 'card__img' }}
      {%- if product.images[1] -%}
        {{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: '', class: 'card__img card__img--hover' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__img placeholder' }}
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="badge badge--dark">Agotado</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="badge">Oferta</span>
    {%- endif -%}
  </a>
  <div class="card__info">
    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'price', product: product %}
  </div>
  {%- if buy_now -%}
    {%- if product.available == false -%}
      <a class="btn btn--ghost btn--block card__buy" href="{{ product.url }}">Ver producto</a>
    {%- elsif product.variants.size == 1 -%}
      <a class="btn btn--accent btn--block card__buy" href="{{ routes.cart_url }}/{{ product.variants.first.id }}:1">Comprar ahora</a>
    {%- else -%}
      <a class="btn btn--accent btn--block card__buy" href="{{ product.url }}">Elegir y comprar</a>
    {%- endif -%}
  {%- endif -%}
</article>
