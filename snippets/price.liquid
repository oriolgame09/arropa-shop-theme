{%- comment -%} Uso: {% render 'price', product: product %} {%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  {%- if product.price_varies -%}
    <span class="price__from">Desde</span>
  {%- endif -%}
  <span class="price__current" data-price>{{ product.price | money }}</span>
  {%- if on_sale -%}
    <s class="price__compare" data-compare>{{ product.compare_at_price | money }}</s>
  {%- endif -%}
</div>
